<controls:ProWindow x:Class="ParcelWorkflowAddIn.RtExaminationWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
                    Title="RT Examination"
                    Width="1080"
                    Height="740"
                    MinWidth="920"
                    MinHeight="620"
                    WindowStartupLocation="CenterOwner">
  <Grid Background="#F4F7F9">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#EAF2F7" BorderBrush="#C8D6DF" BorderThickness="0,0,0,1" Padding="10,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <TextBlock FontWeight="SemiBold" Text="Transaction:" />
          <TextBlock Margin="6,0,16,0" Text="{Binding TransactionNumber}" />
          <TextBlock FontWeight="SemiBold" Text="Stage:" />
          <TextBlock Margin="6,0,16,0" Text="{Binding StageName}" />
          <TextBlock FontWeight="SemiBold" Text="PE Plan No.:" />
          <TextBlock Margin="6,0,16,0" Text="{Binding PePlanNumberText}" />
          <TextBlock FontWeight="SemiBold" Text="Originating PE:" />
          <TextBlock Margin="6,0,0,0" Text="{Binding OriginatingPeText}" />
        </StackPanel>
        <TextBlock Grid.Column="1" Foreground="#41515A" Text="Attribute review only" />
      </Grid>
    </Border>

    <TabControl Grid.Row="1" Margin="8">
      <TabItem Header="Context">
        <Grid Margin="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal">
            <Button Width="136" Height="28" Content="Load Linked PE Data" Command="{Binding LoadLinkedPeDataCommand}" />
            <Button Width="80" Height="28" Margin="8,0,0,0" Content="Save" Command="{Binding SaveCommand}" />
            <Button Width="168" Height="28" Margin="8,0,0,0" Content="Complete RT Examination" Command="{Binding CompleteCommand}" />
            <Button Width="86" Height="28" Margin="8,0,0,0" Content="Suspend" Command="{Binding SuspendCommand}" />
            <Button Width="86" Height="28" Margin="8,0,0,0" Content="Cancel" Command="{Binding CancelCommand}" />
          </StackPanel>
          <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#C8D6DF" BorderThickness="1" Padding="8" Margin="0,8,0,8">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="Linked PE Context" />
              <TextBlock Margin="0,6,0,0" Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="#41515A" />
            </StackPanel>
          </Border>
          <GroupBox Grid.Row="2" Header="Warnings">
            <ListBox ItemsSource="{Binding Warnings}" />
          </GroupBox>
        </Grid>
      </TabItem>

      <TabItem Header="Neighbors / Parties">
        <DataGrid Margin="8"
                  AutoGenerateColumns="False"
                  CanUserAddRows="True"
                  CanUserDeleteRows="True"
                  ItemsSource="{Binding PartyRows}">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Role" Width="140">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Role}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
              <DataGridTemplateColumn.CellEditingTemplate>
                <DataTemplate>
                  <ComboBox ItemsSource="{Binding AllowedRoles}" SelectedItem="{Binding Role, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellEditingTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Name" Width="1.6*" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <DataGridTextColumn Header="Address" Width="2*" Binding="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <DataGridTextColumn Header="Volume" Width="90" Binding="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <DataGridTextColumn Header="Folio" Width="90" Binding="{Binding Folio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <DataGridTextColumn Header="Lot" Width="90" Binding="{Binding Lot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <DataGridTextColumn Header="LandVal No." Width="120" Binding="{Binding LandValNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <DataGridTextColumn Header="Exam No." Width="110" Binding="{Binding ExamNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>

      <TabItem Header="Spatial Units">
        <DataGrid Margin="8"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  ItemsSource="{Binding SpatialUnitAttributes}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Spatial Unit" Width="1.2*" Binding="{Binding SpatialUnitId}" IsReadOnly="True" />
            <DataGridTextColumn Header="Field" Width="1.2*" Binding="{Binding FieldName}" IsReadOnly="True" />
            <DataGridTextColumn Header="Original" Width="1.4*" Binding="{Binding OriginalValue}" IsReadOnly="True" />
            <DataGridTextColumn Header="Reviewed" Width="1.6*" Binding="{Binding ReviewedValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>

      <TabItem Header="Plan Check">
        <Grid Margin="8">
          <TextBox Text="{Binding Observations, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
        </Grid>
      </TabItem>

      <TabItem Header="Sources / Map Evidence">
        <Grid Margin="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="Linked PE sources and working_review query evidence." FontWeight="SemiBold" />
          <ListBox Grid.Row="1" Margin="0,8,0,0" ItemsSource="{Binding SourceLabels}" />
        </Grid>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#C8D6DF" BorderThickness="0,1,0,0" Padding="10,6">
      <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="#41515A" />
    </Border>
  </Grid>
</controls:ProWindow>