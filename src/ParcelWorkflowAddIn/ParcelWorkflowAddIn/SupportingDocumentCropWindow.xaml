<controls:ProWindow x:Class="ParcelWorkflowAddIn.SupportingDocumentCropWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
                    x:ClassModifier="internal"
                    Title="Crop Supporting Document"
                    Width="880"
                    Height="760"
                    MinWidth="680"
                    MinHeight="520"
                    WindowStartupLocation="CenterOwner"
                    Background="#F7F8FA">
  <DockPanel LastChildFill="True">
    <Border DockPanel.Dock="Top"
            Background="#FFFFFF"
            BorderBrush="#C9D2D8"
            BorderThickness="0,0,0,1"
            Padding="10">
      <DockPanel LastChildFill="False">
        <StackPanel Orientation="Horizontal"
                    DockPanel.Dock="Left"
                    VerticalAlignment="Center">
          <Button Content="Previous"
                  Width="72"
                  Margin="0,0,6,0"
                  Click="PreviousPageButton_Click" />
          <TextBlock x:Name="PageStatusTextBlock"
                     VerticalAlignment="Center"
                     Foreground="#1F2933"
                     MinWidth="96"
                     Text="Page 1 of 1" />
          <Button Content="Next"
                  Width="72"
                  Margin="6,0,14,0"
                  Click="NextPageButton_Click" />
          <TextBlock Text="DPI"
                     VerticalAlignment="Center"
                     Margin="0,0,6,0" />
          <ComboBox x:Name="DpiComboBox"
                    Width="76"
                    SelectedIndex="1">
            <ComboBoxItem Content="200" />
            <ComboBoxItem Content="300" />
            <ComboBoxItem Content="400" />
            <ComboBoxItem Content="600" />
          </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal"
                    DockPanel.Dock="Right"
                    VerticalAlignment="Center">
          <Button Content="Clear"
                  Width="64"
                  Margin="0,0,6,0"
                  Click="ClearButton_Click" />
          <Button Content="Save PNG"
                  Width="84"
                  Margin="0,0,6,0"
                  Click="SaveButton_Click" />
          <Button x:Name="AttachButton"
                  Content="Attach"
                  Width="72"
                  Margin="0,0,6,0"
                  IsEnabled="False"
                  Click="AttachButton_Click" />
          <Button Content="Close"
                  Width="72"
                  Click="CloseButton_Click" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom"
            Background="#FFFFFF"
            BorderBrush="#C9D2D8"
            BorderThickness="0,1,0,0"
            Padding="10">
      <TextBlock x:Name="StatusTextBlock"
                 TextWrapping="Wrap"
                 Foreground="#52616B" />
    </Border>

    <ScrollViewer x:Name="PreviewScrollViewer"
                  Margin="10"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  Background="#E9EEF2">
      <Canvas x:Name="PreviewCanvas"
              Background="#FFFFFF"
              MouseLeftButtonDown="PreviewCanvas_MouseLeftButtonDown"
              MouseMove="PreviewCanvas_MouseMove"
              MouseLeftButtonUp="PreviewCanvas_MouseLeftButtonUp">
        <Image x:Name="PreviewImage"
               RenderOptions.BitmapScalingMode="HighQuality"
               Stretch="None" />
        <Rectangle x:Name="SelectionRectangle"
                   Stroke="#0078D4"
                   StrokeThickness="2"
                   Fill="#330078D4"
                   Visibility="Collapsed" />
      </Canvas>
    </ScrollViewer>
  </DockPanel>
</controls:ProWindow>
