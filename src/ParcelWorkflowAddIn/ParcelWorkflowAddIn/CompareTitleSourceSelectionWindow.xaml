<Window x:Class="ParcelWorkflowAddIn.CompareTitleSourceSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Title Source"
        Width="620"
        Height="330"
        MinWidth="520"
        MinHeight="260"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Text="Multiple current title sources were returned. Select the document to download."
               TextWrapping="Wrap"
               Foreground="#334E68" />

    <ListView x:Name="SourcesList"
              Grid.Row="1"
              Margin="0,8,0,8"
              BorderBrush="#C8D6DF"
              BorderThickness="1">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="Title" Width="220" DisplayMemberBinding="{Binding DisplayName}" />
          <GridViewColumn Header="Reference" Width="110" DisplayMemberBinding="{Binding ReferenceNo}" />
          <GridViewColumn Header="Type" Width="110" DisplayMemberBinding="{Binding DocumentType}" />
          <GridViewColumn Header="Status" Width="120" DisplayMemberBinding="{Binding Status}" />
        </GridView>
      </ListView.View>
    </ListView>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Width="84" Height="26" Margin="0,0,8,0" Content="Cancel" IsCancel="True" />
      <Button Width="84" Height="26" Content="Download" IsDefault="True" Click="DownloadClick" />
    </StackPanel>
  </Grid>
</Window>
