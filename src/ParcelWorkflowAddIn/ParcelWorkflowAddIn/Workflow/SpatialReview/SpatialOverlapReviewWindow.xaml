<controls:ProWindow x:Class="ParcelWorkflowAddIn.Workflow.SpatialReview.SpatialOverlapReviewWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
                    x:ClassModifier="internal"
                    Title="{Binding WindowTitle}"
                    Width="1180"
                    Height="760"
                    MinWidth="980"
                    MinHeight="620"
                    WindowStartupLocation="CenterOwner"
                    Background="#F6F8FA">
  <controls:ProWindow.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </controls:ProWindow.Resources>
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="#EAF2F7"
            BorderBrush="#C8D6DF"
            BorderThickness="1"
            Padding="12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding HeaderTitle}"
                     FontSize="16"
                     FontWeight="SemiBold"
                     Foreground="#1F2933" />
          <TextBlock Margin="0,4,0,0"
                     Text="{Binding SummaryText}"
                     Foreground="#334E68"
                     TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Top">
          <Border Background="#F3F6F7"
                  BorderBrush="#C9D2D8"
                  BorderThickness="1"
                  Padding="8,4"
                  Margin="0,0,8,0">
            <TextBlock Text="{Binding ScopeLabel}" />
          </Border>
          <Border Background="#F3F6F7"
                  BorderBrush="#C9D2D8"
                  BorderThickness="1"
                  Padding="8,4">
            <TextBlock Text="{Binding ReviewAreaText}" />
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1"
          Margin="0,12,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.RowSpan="2"
              Grid.Column="0"
              Background="#FFFFFF"
              BorderBrush="#C8D6DF"
              BorderThickness="1"
              Padding="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Configured layer results"
                       FontWeight="SemiBold"
                       Foreground="#1F2933" />
            <ListView Margin="0,8,0,0"
                      ItemsSource="{Binding LayerResults}"
                      BorderBrush="#D5E0E7"
                      BorderThickness="1"
                      MinHeight="220">
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="Layer"
                                  Width="110"
                                  DisplayMemberBinding="{Binding LayerName}" />
                  <GridViewColumn Header="Result"
                                  Width="88"
                                  DisplayMemberBinding="{Binding ResultType}" />
                  <GridViewColumn Header="Rows"
                                  Width="44"
                                  DisplayMemberBinding="{Binding RecordCount}" />
                </GridView>
              </ListView.View>
            </ListView>

            <TextBlock Margin="0,14,0,0"
                       Text="{Binding ReviewLayerSummary}"
                       Foreground="#52616B"
                       TextWrapping="Wrap" />

            <Border Margin="0,14,0,0"
                    Padding="10"
                    Background="#F8FBFD"
                    BorderBrush="#D9E2EC"
                    BorderThickness="1"
                    Visibility="{Binding HasNoOverlapResult, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{Binding NoOverlapText}"
                         Foreground="#334E68"
                         TextWrapping="Wrap" />
            </Border>

            <Border Margin="0,14,0,0"
                    Padding="10"
                    Background="#FFF8E6"
                    BorderBrush="#F2D27A"
                    BorderThickness="1"
                    Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
              <StackPanel>
                <TextBlock Text="Warnings"
                           FontWeight="SemiBold"
                           Foreground="#7C5E10" />
                <ItemsControl ItemsSource="{Binding Warnings}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Margin="0,6,0,0"
                                 Text="{Binding}"
                                 Foreground="#7C5E10"
                                 TextWrapping="Wrap" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Margin="0,14,0,0"
                    Padding="10"
                    Background="#FFF1F1"
                    BorderBrush="#E7B5B5"
                    BorderThickness="1"
                    Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}">
              <StackPanel>
                <TextBlock Text="Errors"
                           FontWeight="SemiBold"
                           Foreground="#B42318" />
                <ItemsControl ItemsSource="{Binding Errors}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Margin="0,6,0,0"
                                 Text="{Binding}"
                                 Foreground="#B42318"
                                 TextWrapping="Wrap" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <GridSplitter Grid.Column="1"
                    Grid.RowSpan="2"
                    Width="10"
                    HorizontalAlignment="Stretch"
                    Background="#D5E0E7"
                    ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext"
                    ShowsPreview="True" />

      <Border Grid.Column="2"
              Grid.Row="0"
              Background="#FFFFFF"
              BorderBrush="#C8D6DF"
              BorderThickness="1"
              Padding="10">
        <DockPanel LastChildFill="True">
          <TextBlock Text="Overlap evidence rows"
                     FontWeight="SemiBold"
                     Foreground="#1F2933" />
          <TextBlock DockPanel.Dock="Right"
                     Text="{Binding SnapshotStatusText}"
                     Foreground="#52616B"
                     TextWrapping="Wrap" />
        </DockPanel>
      </Border>

      <Border Grid.Column="2"
              Grid.Row="1"
              Margin="0,10,0,0"
              Background="#FFFFFF"
              BorderBrush="#C8D6DF"
              BorderThickness="1"
              Padding="10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <DataGrid Grid.Row="0"
                    ItemsSource="{Binding Records}"
                    SelectedItem="{Binding SelectedRecord, Mode=TwoWay}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserAddRows="False"
                    HeadersVisibility="Column"
                    GridLinesVisibility="Horizontal"
                    RowHeaderWidth="0"
                    SelectionMode="Single"
                    SelectionUnit="FullRow">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Overlap Id" Binding="{Binding DisplayOverlapId}" Width="150" />
              <DataGridTextColumn Header="Group Id" Binding="{Binding DisplayOverlapGroupId}" Width="150" />
              <DataGridTextColumn Header="Layer / Source" Binding="{Binding LayerDisplay}" Width="170" />
              <DataGridTextColumn Header="Review parcel" Binding="{Binding Record.ParcelId}" Width="110" />
              <DataGridTextColumn Header="Feature id" Binding="{Binding Record.FeatureIdentity}" Width="130" />
              <DataGridTextColumn Header="Area m²" Binding="{Binding OverlapAreaText}" Width="86" />
              <DataGridTextColumn Header="% review" Binding="{Binding OverlapPercentText}" Width="76" />
              <DataGridTextColumn Header="Relationship" Binding="{Binding Record.Relationship}" Width="96" />
              <DataGridTextColumn Header="Identifiers" Binding="{Binding IdentifierDisplay}" Width="260" />
              <DataGridTextColumn Header="Enrichment" Binding="{Binding EnrichmentStatus}" Width="98" />
              <DataGridTextColumn Header="Owner / Record" Binding="{Binding EnrichmentSummary}" Width="240" />
            </DataGrid.Columns>
          </DataGrid>

          <GridSplitter Grid.Row="1"
                        Height="12"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch"
                        Background="#D5E0E7"
                        ResizeDirection="Rows"
                        ResizeBehavior="PreviousAndNext"
                        ShowsPreview="True" />

          <Grid Grid.Row="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="120" />
              <RowDefinition Height="12" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Owner / property enrichment"
                       FontWeight="SemiBold"
                       Foreground="#1F2933" />
            <TextBlock Grid.Row="1"
                       Margin="0,8,0,0"
                       Text="{Binding OwnerMatchStatusText}"
                       Foreground="#52616B"
                       TextWrapping="Wrap" />
            <TextBlock Grid.Row="2"
                       Margin="0,6,0,0"
                       Text="{Binding SelectedRecord.EnrichmentDiagnostic}"
                       Foreground="#7B8794"
                       TextWrapping="Wrap" />
            <Border Grid.Row="3"
                    Margin="0,8,0,0"
                    Background="#F8FBFD"
                    BorderBrush="#D9E2EC"
                    BorderThickness="1"
                    Padding="8">
              <ListView ItemsSource="{Binding OwnerMatches}"
                        BorderThickness="0"
                        Visibility="{Binding HasOwnerMatches, Converter={StaticResource BoolToVisibility}}">
                <ListView.View>
                  <GridView>
                    <GridViewColumn Header="Owner / Record" Width="210" DisplayMemberBinding="{Binding DisplayName}" />
                    <GridViewColumn Header="Identifiers" Width="230" DisplayMemberBinding="{Binding IdentifierSummary}" />
                    <GridViewColumn Header="Details" Width="260" DisplayMemberBinding="{Binding DetailSummary}" />
                    <GridViewColumn Header="Status" Width="110" DisplayMemberBinding="{Binding Status}" />
                    <GridViewColumn Header="Query" Width="200" DisplayMemberBinding="{Binding QueryKey}" />
                  </GridView>
                </ListView.View>
              </ListView>
            </Border>

            <GridSplitter Grid.Row="4"
                          Height="12"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Stretch"
                          Background="#D5E0E7"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="True" />

            <TextBlock Grid.Row="5"
                       Margin="0,0,0,8"
                       Text="Snapshot references"
                       FontWeight="SemiBold"
                       Foreground="#1F2933"
                       VerticalAlignment="Top" />
            <Border Grid.Row="6"
                    Margin="0,8,0,0"
                    Background="#F8FBFD"
                    BorderBrush="#D9E2EC"
                    BorderThickness="1"
                    Padding="8">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListView ItemsSource="{Binding SnapshotRefs}"
                          BorderThickness="0"
                          Visibility="{Binding HasSnapshots, Converter={StaticResource BoolToVisibility}}">
                  <ListView.View>
                    <GridView>
                      <GridViewColumn Header="Caption" Width="220" DisplayMemberBinding="{Binding Caption}" />
                      <GridViewColumn Header="Status" Width="110" DisplayMemberBinding="{Binding Status}" />
                      <GridViewColumn Header="File" Width="240" DisplayMemberBinding="{Binding FileName}" />
                      <GridViewColumn Header="Reference" Width="260" DisplayMemberBinding="{Binding RelativePath}" />
                    </GridView>
                  </ListView.View>
                </ListView>
                <TextBlock Grid.Row="1"
                           Text="Images are optional. If capture is not configured yet, this section keeps the stable overlap-to-evidence linking ready."
                           Foreground="#52616B"
                           TextWrapping="Wrap" />
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2"
            Background="#FFFFFF"
            BorderBrush="#C8D6DF"
            BorderThickness="1"
            Padding="10">
      <DockPanel>
        <TextBlock Text="This review surface keeps overlap rows, identifiers, enrichment status, and image references together for Compute and Compare."
                   Foreground="#52616B"
                   TextWrapping="Wrap" />
        <Button DockPanel.Dock="Right"
                Width="92"
                Height="28"
                Margin="12,0,0,0"
                IsDefault="True"
                Content="Close"
                Click="CloseButton_Click" />
      </DockPanel>
    </Border>
  </Grid>
</controls:ProWindow>
