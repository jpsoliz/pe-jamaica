<UserControl x:Class="ParcelWorkflowAddIn.SupportingDocumentsDockpane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ParcelWorkflowAddIn"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:SupportingDocumentsDockpaneViewModel}"
             Background="#F7F8FA"
             FontFamily="Segoe UI">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <Style x:Key="CompactButtonStyle" TargetType="Button">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="BorderBrush" Value="#C9D2D8" />
      <Setter Property="Background" Value="#FFFFFF" />
    </Style>

    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource CompactButtonStyle}">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="MinWidth" Value="30" />
      <Setter Property="Padding" Value="6,4" />
    </Style>

    <Style x:Key="CardBorderStyle" TargetType="Border">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#C9D2D8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="10" />
    </Style>
  </UserControl.Resources>

  <DockPanel LastChildFill="True">
    <Border DockPanel.Dock="Top"
            Background="#FFFFFF"
            BorderBrush="#C9D2D8"
            BorderThickness="0,0,0,1"
            Padding="12">
      <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right"
                Content="&#xE72C;"
                Command="{Binding ReloadSupportingDocumentViewerCommand}"
                Style="{StaticResource IconButtonStyle}"
                ToolTip="Refresh supporting documents"
                Margin="8,0,0,0" />
        <StackPanel>
          <ComboBox ItemsSource="{Binding SupportingDocumentOptions}"
                    SelectedItem="{Binding SelectedSupportingDocument, Mode=TwoWay}"
                    DisplayMemberPath="DisplayLabel"
                    IsEnabled="{Binding HasSupportingDocumentOptions}"
                    MinHeight="28" />
          <TextBlock Text="{Binding SupportingDocumentListSummary}"
                     FontSize="11"
                     Foreground="#52616B"
                     TextWrapping="Wrap"
                     Margin="0,6,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Margin="8"
            Style="{StaticResource CardBorderStyle}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
          <TextBlock Text="{Binding SelectedSupportingDocumentTitle}"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Foreground="#1F2933"
                     TextWrapping="Wrap" />
          <TextBlock Text="{Binding SelectedSupportingDocumentPath}"
                     FontSize="11"
                     Foreground="#52616B"
                     TextWrapping="Wrap"
                     Margin="0,4,0,0" />
          <TextBlock Text="{Binding SupportingDocumentViewerStatusDetail}"
                     FontSize="11"
                     Foreground="#52616B"
                     TextWrapping="Wrap"
                     Margin="0,6,0,0" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="#F3F6F7"
                BorderBrush="#E1E8ED"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8"
                Margin="0,10,0,10">
          <TextBlock Text="Select a supporting document from the current transaction. Refresh reloads the source folder."
                     FontSize="11"
                     Foreground="#52616B"
                     TextWrapping="Wrap" />
        </Border>

        <ListBox Grid.Row="2"
                 ItemsSource="{Binding SupportingDocumentOptions}"
                 SelectedItem="{Binding SelectedSupportingDocument, Mode=TwoWay}"
                 DisplayMemberPath="DisplayLabel"
                 BorderBrush="#E1E8ED"
                 BorderThickness="1"
                 Visibility="{Binding HasSupportingDocumentOptions, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <TextBlock Grid.Row="2"
                   Text="{Binding SupportingDocumentEmptyText}"
                   FontSize="12"
                   Foreground="#52616B"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasSupportingDocumentOptions}" Value="False">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
    </Border>
  </DockPanel>
</UserControl>
