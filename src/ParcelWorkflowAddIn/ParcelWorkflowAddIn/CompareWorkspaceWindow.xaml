<controls:ProWindow x:Class="ParcelWorkflowAddIn.CompareWorkspaceWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
                    Title="Compare Workspace"
                    Width="1040"
                    Height="760"
                    MinWidth="880"
                    MinHeight="640"
                    WindowStartupLocation="CenterOwner">
  <controls:ProWindow.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <Style x:Key="CompareIconImageStyle" TargetType="Image">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </controls:ProWindow.Resources>
  <Grid Background="#F4F7F9">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#EAF2F7" BorderBrush="#C8D6DF" BorderThickness="0,0,0,1" Padding="10,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding TransactionNumber, StringFormat=Transaction Number: {0}}" />
          <TextBlock Margin="0,3,0,0" Foreground="#41515A" Text="{Binding TaskName, StringFormat=Compare - {0}}" />
        </StackPanel>
        <Border Grid.Column="1" BorderBrush="#9CB1BE" BorderThickness="1" Background="#FFFFFF" Padding="8,3" VerticalAlignment="Center">
          <TextBlock Text="Read-only geometry" />
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="PdfPanelColumn" Width="390" />
        <ColumnDefinition x:Name="PdfPanelSpacerColumn" Width="8" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border x:Name="PdfPanel" Grid.Column="0" Background="#FFFFFF" BorderBrush="#C8D6DF" BorderThickness="1" Padding="8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel>
            <DockPanel>
              <Button DockPanel.Dock="Right"
                      Width="86"
                      Height="24"
                      Command="{Binding TogglePdfPanelCommand}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <Image Style="{StaticResource CompareIconImageStyle}" Source="Images/CompareIcons/CompareShowFiles.png" />
                  <TextBlock VerticalAlignment="Center" Text="{Binding PdfPanelToggleText}" />
                </StackPanel>
              </Button>
              <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Attached Documents" />
            </DockPanel>
            <TextBlock Margin="0,3,0,8" Foreground="#53636A" Text="{Binding DocumentStatus}" TextWrapping="Wrap" />
            <ComboBox ItemsSource="{Binding PdfDocuments}"
                      SelectedValue="{Binding SelectedDocument, Mode=TwoWay}"
                      SelectedValuePath="SourceFile"
                      IsEnabled="{Binding HasPdfDocuments}"
                      DisplayMemberPath="FileName"
                      BorderBrush="#C8D6DF" />
            <TextBlock Margin="0,4,0,8" Foreground="#53636A" Text="{Binding PdfDocumentSelectorStatus}" TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock Grid.Row="1" Margin="0,10,0,6" FontWeight="SemiBold" Text="{Binding ViewerTitle}" />
          <Border Grid.Row="2" Background="#F7FAFC" BorderBrush="#D5E0E7" BorderThickness="1">
            <Grid>
              <Grid x:Name="DocumentWebViewHost" Visibility="Collapsed" />
              <ScrollViewer x:Name="ImageScrollViewer" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Image x:Name="DocumentImage" Stretch="Uniform" Margin="6" />
              </ScrollViewer>
              <TextBlock x:Name="DocumentFallbackText" Margin="16" Text="{Binding ViewerFallbackMessage}" TextWrapping="Wrap" Foreground="#41515A" />
            </Grid>
          </Border>
        </Grid>
      </Border>

      <GridSplitter x:Name="PdfPanelSplitter"
                    Grid.Column="1"
                    Width="8"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="#D5E0E7"
                    ResizeBehavior="PreviousAndNext"
                    ResizeDirection="Columns"
                    ShowsPreview="True" />

      <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#C8D6DF" BorderThickness="1" Padding="8">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Border Background="#EEF5F3" BorderBrush="#C9D8D4" BorderThickness="1" Padding="8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Button Width="138"
                      Height="26"
                      Command="{Binding ReloadGeometryCommand}"
                      ToolTip="Loads or refreshes the Compare working layers and adjacent cadastre context in the ArcGIS Pro map.">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <Image Style="{StaticResource CompareIconImageStyle}" Source="Images/CompareIcons/CompareLoad.png" />
                  <TextBlock VerticalAlignment="Center" Text="Load Compare Layers" />
                </StackPanel>
              </Button>
                <Button Grid.Column="1"
                      Width="146"
                      Height="26"
                      Margin="10,0,0,0"
                      HorizontalAlignment="Left"
                      Command="{Binding RunOverlapReviewCommand}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <Image Style="{StaticResource CompareIconImageStyle}" Source="Images/CompareIcons/CompareRun.png" />
                  <TextBlock VerticalAlignment="Center" Text="Run Overlap Review" />
                </StackPanel>
              </Button>
              <Button Grid.Column="1"
                      Width="146"
                      Height="26"
                      Margin="166,0,0,0"
                      HorizontalAlignment="Left"
                      Command="{Binding OpenOverlapReviewCommand}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <Image Style="{StaticResource CompareIconImageStyle}" Source="Images/CompareIcons/CompareView.png" />
                  <TextBlock VerticalAlignment="Center" Text="View Overlap Review" />
                </StackPanel>
              </Button>
              <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="86" Height="26" Command="{Binding TogglePdfPanelCommand}">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Style="{StaticResource CompareIconImageStyle}" Source="Images/CompareIcons/CompareShowFiles.png" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding PdfPanelToggleText}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </Border>

          <Border Grid.Row="1" Margin="0,10,0,0" Background="#F5F7FA" BorderBrush="#D9E2EC" BorderThickness="1" Padding="8">
            <TextBlock Text="{Binding OverlapReviewStatus}" Foreground="#334E68" TextWrapping="Wrap" />
          </Border>

          <Border Grid.Row="2" Margin="0,10,0,0" Background="#FFFFFF" BorderBrush="#C8D6DF" BorderThickness="1" Padding="8">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock FontWeight="SemiBold" Text="Computed Participants" />
                <Button Grid.Column="1"
                        Width="148"
                        Height="24"
                        Command="{Binding SearchTitleImageCommand}">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Style="{StaticResource CompareIconImageStyle}" Source="Images/CompareIcons/SearchTitleImages.png" />
                    <TextBlock VerticalAlignment="Center" Text="Search Title Image" />
                  </StackPanel>
                </Button>
              </Grid>
              <TextBlock Grid.Row="1" Margin="0,4,0,6" Foreground="#315C6B" Text="{Binding ComputedParticipantsStatus}" TextWrapping="Wrap" />
              <ListView Grid.Row="2"
                        ItemsSource="{Binding ComputedParticipants}"
                        SelectedItem="{Binding SelectedComputedParticipant, Mode=TwoWay}"
                        BorderBrush="#D5E0E7"
                        BorderThickness="1"
                        MinHeight="86"
                        MaxHeight="170"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.View>
                  <GridView>
                    <GridViewColumn Header="Name" Width="170" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="Role" Width="92" DisplayMemberBinding="{Binding Role}" />
                    <GridViewColumn Header="Lot Number" Width="92" DisplayMemberBinding="{Binding LotNumber}" />
                    <GridViewColumn Header="Address" Width="160" DisplayMemberBinding="{Binding Address}" />
                    <GridViewColumn Header="LandVal No." Width="100" DisplayMemberBinding="{Binding LandValuationNumber}" />
                    <GridViewColumn Header="Exam No" Width="90" DisplayMemberBinding="{Binding ExaminationNumber}" />
                    <GridViewColumn Header="Volume/Folio" Width="100" DisplayMemberBinding="{Binding VolumeFolio}" />
                    <GridViewColumn Header="Source Artifact" Width="105" DisplayMemberBinding="{Binding Source}" />
                    <GridViewColumn Header="Status" Width="95" DisplayMemberBinding="{Binding Status}" />
                  </GridView>
                </ListView.View>
              </ListView>
            </Grid>
          </Border>

          <Border Grid.Row="3" Margin="0,10,0,0" Background="#FFFFFF" BorderBrush="#C8D6DF" BorderThickness="1" Padding="8">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock FontWeight="SemiBold" Text="Ownership Evidence" />
              <Grid Grid.Row="1" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="118" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="78" />
                  <ColumnDefinition Width="78" />
                </Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding EvidenceSearchModes}" SelectedItem="{Binding SelectedEvidenceSearchMode, Mode=TwoWay}" />
                <StackPanel Grid.Column="1" Margin="8,0,8,0">
                  <Grid Visibility="{Binding IsPidSearchMode, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="70" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="PID" />
                    <TextBox Grid.Column="1" Text="{Binding SearchPid, UpdateSourceTrigger=PropertyChanged}" />
                  </Grid>
                  <Grid Visibility="{Binding IsVolumeFolioSearchMode, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="70" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="8" />
                      <ColumnDefinition Width="46" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="Volume" />
                    <TextBox Grid.Column="1" Text="{Binding SearchVolume, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="Folio" />
                    <TextBox Grid.Column="4" Text="{Binding SearchFolio, UpdateSourceTrigger=PropertyChanged}" />
                  </Grid>
                  <Grid Visibility="{Binding IsLandValuationNumberSearchMode, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="90" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="Land Val No." />
                    <TextBox Grid.Column="1" Text="{Binding SearchLandValuationNumber, UpdateSourceTrigger=PropertyChanged}" />
                  </Grid>
                  <Grid Visibility="{Binding IsNameSearchMode, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="70" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="Owner" />
                    <TextBox Grid.Column="1" Text="{Binding SearchName, UpdateSourceTrigger=PropertyChanged}" />
                  </Grid>
                </StackPanel>
                <Button Grid.Column="2" Margin="0,0,6,0" Command="{Binding RunEvidenceSearchCommand}">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Style="{StaticResource CompareIconImageStyle}" Source="Images/CompareIcons/Search.png" />
                    <TextBlock VerticalAlignment="Center" Text="Search" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="3" Command="{Binding ClearEvidenceSearchFieldsCommand}">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Style="{StaticResource CompareIconImageStyle}" Source="Images/CompareIcons/ClearSearch.png" />
                    <TextBlock VerticalAlignment="Center" Text="Clear" />
                  </StackPanel>
                </Button>
              </Grid>
              <StackPanel Grid.Row="2" Margin="0,6,0,0">
                <TextBlock Foreground="#315C6B" Text="{Binding EvidenceSearchStatusMessage}" TextWrapping="Wrap" />
                <TextBlock Margin="0,3,0,0" Foreground="#8A3328" Text="{Binding SearchValidationMessage}" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>

          <StackPanel Grid.Row="4"
                      Margin="0,10,0,0"
                      Visibility="{Binding HasQueryResults, Converter={StaticResource BoolToVisibility}}">
            <TextBlock FontWeight="SemiBold" Text="Search Results" />
            <ListView Margin="0,4,0,0"
                      ItemsSource="{Binding QueryResults}"
                      BorderBrush="#D5E0E7"
                      BorderThickness="1"
                      MaxHeight="220"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="Volume/Folio" Width="92" DisplayMemberBinding="{Binding VolumeFolio}" />
                  <GridViewColumn Header="Type" Width="70" DisplayMemberBinding="{Binding PropertyType}" />
                  <GridViewColumn Header="Tenure" Width="96" DisplayMemberBinding="{Binding Tenure}" />
                  <GridViewColumn Header="PID" Width="90" DisplayMemberBinding="{Binding ParcelId}" />
                  <GridViewColumn Header="LandVal No." Width="110" DisplayMemberBinding="{Binding LandValuationNumber}" />
                  <GridViewColumn Header="Owner" Width="190" DisplayMemberBinding="{Binding Owner}" />
                  <GridViewColumn Header="Parish" Width="92" DisplayMemberBinding="{Binding Parish}" />
                  <GridViewColumn Header="Date Registered" Width="118" DisplayMemberBinding="{Binding DateRegistered}" />
                  <GridViewColumn Header="Action" Width="86">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <Button Width="72"
                                Height="22"
                                Content="Keep"
                                Command="{Binding DataContext.MarkEvidenceResultValuableCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                </GridView>
              </ListView.View>
            </ListView>
          </StackPanel>

          <StackPanel Grid.Row="5"
                      Margin="0,10,0,0"
                      Visibility="{Binding HasRelatedPartyMatches, Converter={StaticResource BoolToVisibility}}">
            <TextBlock FontWeight="SemiBold" Text="Related Party Matches" />
            <TextBlock Margin="0,2,0,4" Foreground="#53636A" Text="Party matches returned by Innola for review. Keep only rows that support the Compare decision." TextWrapping="Wrap" />
            <ListView ItemsSource="{Binding RelatedPartyMatches}"
                      MinHeight="72"
                      MaxHeight="160"
                      BorderBrush="#D5E0E7"
                      BorderThickness="1"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="Name" Width="190" DisplayMemberBinding="{Binding PartyName}" />
                  <GridViewColumn Header="PRID" Width="92" DisplayMemberBinding="{Binding Prid}" />
                  <GridViewColumn Header="Address" Width="260" DisplayMemberBinding="{Binding FullAddress}" />
                  <GridViewColumn Header="Tax No." Width="100" DisplayMemberBinding="{Binding TaxNumber}" />
                  <GridViewColumn Header="Status" Width="96" DisplayMemberBinding="{Binding PartyStatus}" />
                  <GridViewColumn Header="Action" Width="86">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <Button Width="72"
                                Height="22"
                                Content="Keep"
                                Command="{Binding DataContext.MarkPartyMatchValuableCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                </GridView>
              </ListView.View>
            </ListView>
          </StackPanel>

          <StackPanel Grid.Row="6"
                      Margin="0,10,0,0"
                      Visibility="{Binding HasValuableEvidenceItems, Converter={StaticResource BoolToVisibility}}">
            <TextBlock FontWeight="SemiBold" Text="Valuable Evidence" />
            <TextBlock Margin="0,2,0,4" Foreground="#53636A" Text="Retained search results for the Compare decision." TextWrapping="Wrap" />
            <ListView ItemsSource="{Binding ValuableEvidenceItems}"
                      MinHeight="72"
                      MaxHeight="132"
                      BorderBrush="#C9D8D4"
                      BorderThickness="1">
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="Role" Width="132">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <ComboBox Width="120"
                                  ItemsSource="{Binding DataContext.EvidenceRoleTags, RelativeSource={RelativeSource AncestorType=Window}}"
                                  SelectedItem="{Binding RoleTag, Mode=TwoWay}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Evidence" Width="480" DisplayMemberBinding="{Binding DisplaySummary}" />
                  <GridViewColumn Header="Action" Width="78">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <Button Width="68"
                                Height="22"
                                Content="Remove"
                                Command="{Binding DataContext.RemoveValuableEvidenceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                </GridView>
              </ListView.View>
            </ListView>
          </StackPanel>

          <Grid Grid.Row="7" Margin="0,10,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock FontWeight="SemiBold" Text="Notes" />
            <TextBox Grid.Row="1" Height="54" Margin="0,6,0,0" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
          </Grid>
        </Grid>
        </ScrollViewer>
      </Border>
    </Grid>

    <Grid Grid.Row="2" Background="#FFFFFF" Margin="10,0,10,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
        <Button Width="100"
                Margin="0,6,6,6"
                ToolTip="Saves the current Compare status and regenerates the PDF report without changing task ownership or stage."
                Command="{Binding SaveProgressCommand}">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Image Style="{StaticResource CompareIconImageStyle}" Source="Images/CompareIcons/CompareSave.png" />
            <TextBlock VerticalAlignment="Center" Text="Save" />
          </StackPanel>
        </Button>
        <Button Width="100"
                Margin="0,6,6,6"
                Command="{Binding SuspendTaskCommand}">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Image Style="{StaticResource CompareIconImageStyle}" Source="Images/CompareIcons/CompareSuspend.png" />
            <TextBlock VerticalAlignment="Center" Text="Suspend" />
          </StackPanel>
        </Button>
        <Button Width="100"
                Margin="0,6,6,6"
                ToolTip="Saves the current Compare status, regenerates and uploads the PDF report, finalizes the transaction task, and clears the workspace."
                Command="{Binding ApproveCompareCommand}">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Image Style="{StaticResource CompareIconImageStyle}" Source="Images/CompareIcons/CompareFinalize.png" />
            <TextBlock VerticalAlignment="Center" Text="Finalize" />
          </StackPanel>
        </Button>
      </StackPanel>
      <StackPanel Grid.Column="0"
                  Margin="316,0,12,0"
                  Orientation="Horizontal"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center"
                  Visibility="{Binding IsFinalizeOperationRunning, Converter={StaticResource BoolToVisibility}}">
        <ProgressBar Width="64"
                     Height="8"
                     IsIndeterminate="True"
                     VerticalAlignment="Center" />
        <TextBlock Text="{Binding FinalizeOperationRunningText}"
                   Margin="6,0,0,0"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="#334E68"
                   VerticalAlignment="Center" />
      </StackPanel>
      <Button Grid.Column="1"
              Width="100"
              Margin="0,6,8,6"
              ToolTip="Cancels the Compare workspace without saving, then clears the form and Compare map content."
              Command="{Binding CancelTaskCommand}">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Image Style="{StaticResource CompareIconImageStyle}" Source="Images/CompareIcons/CompareCancel.png" />
          <TextBlock VerticalAlignment="Center" Text="Cancel" />
        </StackPanel>
      </Button>
    </Grid>
  </Grid>
</controls:ProWindow>
